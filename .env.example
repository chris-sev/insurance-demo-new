# Copy to .env.local and fill in. Never commit real secrets.
# See SETUP.md and CONTRIBUTING.md for how each value is obtained.

APP_BASE_URL=http://localhost:3000

AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
# AUTH0_AUDIENCE=

DATABASE_URL=

# Vercel AI Gateway — OIDC via `vercel env pull`, or a static key:
# https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys
AI_GATEWAY_API_KEY=
# Optional override (default anthropic/claude-opus-5)
# AI_GATEWAY_MODEL=anthropic/claude-opus-5

# Optional seed for the presenter identity. Prefer setting these on /host
# (Demo host card). Live values live in Neon demo_settings.
# DEMO_HOST_EMAIL=
# DEMO_HOST_SUB=

# Board size and CIBA yes threshold are set on /host (Board rules),
# stored in Neon demo_settings. Default is pick 1 / 1 yes.
# Raise to 6 / 3 on /host for the stage talk.

# Optional: extra operator logins for /host and /settings, comma separated
# DEMO_ADMIN_EMAILS=you@example.com
